  "original_equations": {
    "eq:motion_force_prediction": "a_{k+j}=\\begin{bmatrix}p_{k+j}^{\\mathrm{ref}}\\\\\\rho_{k+j}^{\\mathrm{ref}}\\\\f_{k+j}^{\\mathrm{target}}\\end{bmatrix}\\in\\R^9, \\qquad j=0,\\ldots,H-1. \\label{eq:motion_force_prediction}",
    "eq:relative_task_pose": "\\widetilde p_k=[p_{k,x}-c_x,\\ p_{k,y}-c_y,\\ p_{k,z}]^\\mathsf{T}, \\qquad \\widetilde\\rho_k=\\rho_k. \\label{eq:relative_task_pose}",
    "eq:stain_canonical_observation": "u_k=R_2(\\alpha)(p_{k,xy}-c). \\label{eq:stain_canonical_observation}",
    "eq:stain_canonical_action": "p_{k+j,xy}^{\\mathrm{ref}} =c+R_2(-\\alpha)\\widehat u_{k+j}. \\label{eq:stain_canonical_action}",
    "eq:demo_transfer": "{}^BT_E(t)={}^BT_V\\,{}^VT_T(t)\\,{}^TT_E. \\label{eq:demo_transfer}",
    "eq:force_ema": "\\bar f_k=\\alpha f_k+(1-\\alpha)\\bar f_{k-1}. \\label{eq:force_ema}",
    "eq:normal_force_projection": "R_{E\\leftarrow\\mathrm{pub}}=I,\\qquad f_B(t)=R_{B\\leftarrow E}(t)\\,f_{\\mathrm{pub,processed}}(t). \\label{eq:normal_force_projection}",
    "eq:minmax_normalization": "\\mathcal N_d(x)=2\\frac{x-m_d}{\\max(M_d-m_d,\\epsilon)}-1, \\label{eq:minmax_normalization}",
    "eq:il_observation": "o_k=\\left(I_k,\\widetilde q_k,f_k^{\\mathrm{meas}}, f_{k-L+1:k}^{\\mathrm{meas}}\\right),\\qquad L=30. \\label{eq:il_observation}",
    "eq:flow_training_path": "Z_s=(1-s)Z_0+sA,\\qquad U=A-Z_0. \\label{eq:flow_training_path}",
    "eq:imitation_loss": "\\mathcal L_{\\mathrm{FM}}= \\frac{\\displaystyle\\sum_{b,j,d}m_{bj} \\left[v_\\theta(Z_{s_b},s_b,c_b)_{jd}-(A_b-Z_{0,b})_{jd}\\right]^2} {d_a\\,\\max\\!\\left(1,\\sum_{b,j}m_{bj}\\right)}. \\label{eq:imitation_loss}",
    "eq:flow_integration": "Z^{(m+1)}=Z^{(m)}+h\\, v_\\theta\\!\\left(Z^{(m)},(m+\\tfrac12)h,c_k\\right), \\quad m=0,\\ldots,M-1. \\label{eq:flow_integration}",
    "eq:plan_connection": "\\beta(u)=10u^3-15u^4+6u^5,\\qquad u=\\min(1,(t-t_b)/0.5), \\label{eq:plan_connection}",
    "eq:command_update": "\\delta x_i=\\operatorname{clip}\\bigl(\\min(1,K\\Delta t)(x_i^\\star-x_i^{\\mathrm{cmd}}), -v_i^{\\max}\\Delta t,v_i^{\\max}\\Delta t\\bigr), \\label{eq:command_update}",
    "eq:admittance_il": "M\\ddot e+D\\dot e+Ke=F_d-F_{\\mathrm{ext}},\\qquad x_c=x_d-e, \\label{eq:admittance_il}",
    "eq:task_band": "u=d^\\mathsf{T}(p_{xy}-P_0),\\qquad v=n^\\mathsf{T}(p_{xy}-P_0). \\label{eq:task_band}",
    "eq:working_height_reference": "z_{\\mathrm{work\\_ref}}=\\inf\\left\\{z: \\int_{\\mathcal S}\\mathbf{1}[Z(t)\\leq z]\\,dt \\geq \\tfrac12\\int_{\\mathcal S}dt\\right\\}. \\label{eq:working_height_reference}",
    "eq:pass_height_release": "Z(t)\\geq z_{\\mathrm{work\\_ref}}+5\\ \\mathrm{mm} \\label{eq:pass_height_release}",
    "eq:excess_force": "J_{\\mathrm{excess}}=\\int_{t_0}^{t_1} \\max\\!\\left(F_z^B(t)-Q_{95},0\\right)\\,dt, \\qquad Q_{95}=\\ForceExposureReference\\ \\mathrm{N}. \\label{eq:excess_force}",
    "eq:e3_removal": "\\mathrm{Removal}(\\%)=100\\,\\frac{A_{\\mathrm{before}}-A_{\\mathrm{after}}}{A_{\\mathrm{before}}}, \\label{eq:e3_removal}",
    "eq:bc_time_difference": "r_t=\\frac{\\overline t_B-\\overline t_C}{\\overline t_B}\\,100 =\\BCPercent\\%. \\label{eq:bc_time_difference}",
    "eq:preston_spatial": "D(x,y)=\\sum_k\\kappa\\,F_{n,k}\\,v_k\\,\\Delta t_k\\, K_{\\mathrm{tool}}(x-x_k,y-y_k), \\label{eq:preston_spatial}",
    "eq:original_release": "Z(t)\\geq z_{\\mathrm{contact}}+5\\ \\mathrm{mm}, \\label{eq:original_release}"
  },
